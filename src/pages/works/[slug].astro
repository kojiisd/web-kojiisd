---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const works = await getCollection("works", ({ data }) => !data.draft);
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { Content } = await render(work);
---

<BaseLayout title={`${work.data.title} | kojiisd`} description={work.data.summary}>
  <article class="pt-8">
    <h1 class="text-3xl font-bold tracking-tight">{work.data.title}</h1>
    <p class="mt-3 text-slate-600 dark:text-slate-400">{work.data.summary}</p>
    <ul class="mt-3 flex flex-wrap gap-2">
      {work.data.tags.map((tag) => <li class="text-sm text-sky-600 dark:text-sky-400">#{tag}</li>)}
    </ul>
    {
      work.data.url && (
        <a
          href={work.data.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-sky-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-sky-700"
        >
          サイトを開く ↗
        </a>
      )
    }
    {work.data.cover && <Image src={work.data.cover} alt="" widths={[800, 1600]} sizes="(min-width: 896px) 832px, 100vw" class="mt-6 w-full rounded-xl" />}
    <div class="prose prose-slate dark:prose-invert mt-8 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
