---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  // url を指定した成果物はタイルから外部に直接飛ぶため、詳細ページを作らない
  const works = await getCollection("works", ({ data }) => !data.draft && !data.url);
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { Content } = await render(work);
---

<BaseLayout title={`${work.data.title} | kojiisd`} description={work.data.summary}>
  <a href="/#works" class="text-sm text-sky-600 hover:underline dark:text-sky-400">← Works</a>
  <article class="mt-6">
    <p class="text-sm text-slate-500">{work.data.date.toLocaleDateString("ja-JP", { timeZone: "Asia/Tokyo" })}</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">{work.data.title}</h1>
    <ul class="mt-3 flex flex-wrap gap-2">
      {work.data.tags.map((tag) => <li class="text-sm text-sky-600 dark:text-sky-400">#{tag}</li>)}
    </ul>
    {work.data.cover && <Image src={work.data.cover} alt="" widths={[800, 1600]} sizes="(min-width: 896px) 832px, 100vw" class="mt-6 w-full rounded-xl" />}
    <div class="prose prose-slate dark:prose-invert mt-8 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
