---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleTiles from "../components/ArticleTiles.astro";
import LinkTiles from "../components/LinkTiles.astro";
import WorkTiles from "../components/WorkTiles.astro";
import { fetchQiitaArticles } from "../lib/qiita";

const site = await getEntry("site", "site");
if (!site) throw new Error("src/content/site.md が見つかりません");

const works = (await getCollection("works", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const articles = await fetchQiitaArticles("kojiisd", 9);
---

<BaseLayout title={site.data.title} description={site.data.tagline ?? site.data.title}>
  <section class="pt-8">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{site.data.title}</h1>
    {site.data.tagline && <p class="mt-3 text-slate-600 dark:text-slate-400">{site.data.tagline}</p>}
  </section>
  <div class="mt-10">
    <LinkTiles links={site.data.links} />
  </div>
  {works.length > 0 && <WorkTiles works={works} />}
  {articles.length > 0 && <ArticleTiles articles={articles} />}
</BaseLayout>
