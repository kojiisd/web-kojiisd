---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 Not Found | kojiisd" description="ページが見つかりません">
  <section class="pt-8">
    <p class="text-sm font-semibold tracking-widest text-sky-600 dark:text-sky-400">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">ページが見つかりません</h1>
    <p class="mt-4 text-slate-600 dark:text-slate-400">URL が変わったか、削除された可能性があります。</p>
    <a href="/" class="mt-8 inline-block text-sky-600 hover:underline dark:text-sky-400">← トップへ戻る</a>
  </section>
</BaseLayout>
