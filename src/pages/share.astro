---
import BaseLayout from "../layouts/BaseLayout.astro";

const url = new URL("/", Astro.site).href;
const snippets = [
  { label: "リンク", text: `[Portfolio of kojiisd](${url})` },
  { label: "一文", text: `ポートフォリオ: [www.kojiisd.jp](${url})` },
  {
    label: "バッジ（GitHub の README など）",
    text: `[![Portfolio](https://img.shields.io/badge/Portfolio-www.kojiisd.jp-0284c7)](${url})`,
  },
];
---

<BaseLayout title="Link to this site | kojiisd" description="このサイトへのリンク用 Markdown">
  <section class="pt-8">
    <h1 class="text-3xl font-bold tracking-tight">Link to this site</h1>
    <p class="mt-3 text-slate-600 dark:text-slate-400">このサイトを紹介するときに貼る Markdown です。</p>
    <ul class="mt-8 space-y-6">
      {
        snippets.map((snippet) => (
          <li>
            <p class="text-sm font-semibold">{snippet.label}</p>
            <div class="mt-2 flex items-stretch gap-2">
              <pre class="flex-1 overflow-x-auto rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm dark:border-slate-800 dark:bg-slate-900"><code>{snippet.text}</code></pre>
              <button
                type="button"
                data-copy={snippet.text}
                class="shrink-0 rounded-lg border border-slate-300 px-4 text-sm font-semibold transition hover:border-sky-500 hover:text-sky-600 dark:border-slate-700 dark:hover:text-sky-400"
              >
                Copy
              </button>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = "Copied";
      setTimeout(() => (button.textContent = "Copy"), 1500);
    });
  }
</script>
