---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BrandIcon from "./BrandIcon.astro";

interface Props {
  profile: CollectionEntry<"profile">;
}

const { profile } = Astro.props;
const { name, title, links } = profile.data;
const { Content } = await render(profile);
---

<section class="pt-8">
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{name}</h1>
  <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{title}</p>
  <div class="prose prose-slate dark:prose-invert mt-8 max-w-none">
    <Content />
  </div>
  <ul class="mt-8 flex flex-wrap gap-3">
    {
      links.map((link) => (
        <li>
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold transition hover:border-sky-500 hover:text-sky-600 dark:border-slate-700 dark:hover:text-sky-400"
          >
            {link.icon && <BrandIcon slug={link.icon} class="size-4" />}
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
