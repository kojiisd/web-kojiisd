---
import type { CollectionEntry } from "astro:content";
import Section from "./Section.astro";

interface Props {
  works: CollectionEntry<"works">[];
}

const { works } = Astro.props;
---

<Section id="works" title="Works">
  <ul class="grid gap-4 sm:grid-cols-2">
    {
      works.map((work) => (
        <li>
          <a
            href={`/works/${work.id}/`}
            class="block h-full rounded-lg border border-slate-200 p-5 transition hover:border-sky-500 dark:border-slate-800"
          >
            <p class="text-xs text-slate-500">{work.data.date.getFullYear()}</p>
            <h3 class="mt-1 font-semibold">{work.data.title}</h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{work.data.summary}</p>
            <ul class="mt-3 flex flex-wrap gap-1">
              {work.data.tags.map((tag) => <li class="text-xs text-sky-600 dark:text-sky-400">#{tag}</li>)}
            </ul>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
