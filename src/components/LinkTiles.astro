---
import type { CollectionEntry } from "astro:content";
import BrandIcon from "./BrandIcon.astro";

interface Props {
  links: CollectionEntry<"site">["data"]["links"];
}

const { links } = Astro.props;
---

<ul class="grid grid-cols-2 gap-4 sm:grid-cols-4">
  {
    links.map((link) => (
      <li>
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center justify-center gap-3 rounded-xl py-8 border border-slate-200 transition hover:border-sky-500 hover:text-sky-600 dark:border-slate-800 dark:hover:text-sky-400"
        >
          {link.icon && <BrandIcon slug={link.icon} class="size-12" />}
          <span class="text-sm font-semibold">{link.label}</span>
        </a>
      </li>
    ))
  }
</ul>
