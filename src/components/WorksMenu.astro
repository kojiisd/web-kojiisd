---
import { getCollection } from "astro:content";

const works = (await getCollection("works", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

{
  works.length > 0 && (
    <details class="group relative">
      <summary class="flex cursor-pointer list-none items-center gap-1 rounded-full px-3 py-1.5 text-sm font-semibold hover:text-sky-600 dark:hover:text-sky-400">
        Works
        <span class="text-xs transition group-open:rotate-180">▾</span>
      </summary>
      <ul class="absolute right-0 z-10 mt-2 w-64 rounded-xl border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-800 dark:bg-slate-900">
        {works.map((work) => (
          <li>
            <a href={`/works/${work.id}/`} class="block rounded-lg px-3 py-2 hover:bg-slate-100 dark:hover:bg-slate-800">
              <span class="block text-sm font-semibold">{work.data.title}</span>
              <span class="block truncate text-xs text-slate-500">{work.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}
